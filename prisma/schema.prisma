generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
  VENDOR
  ATTENDEE
}

enum AttendeeStatus {
  REGISTERED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

enum EventStaffRole {
  OWNER
  OPERATIONS
  CHECK_IN
  SECURITY
  STAGE_MANAGER
  VENDOR_MANAGER
}

enum AnnouncementType {
  INFO
  SUCCESS
  WARNING
  EMERGENCY
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AnnouncementAudience {
  ALL
  ATTENDEES
  STAFF
  ORGANIZERS
}

enum StaffPermission {
  SCAN_QR
  VERIFY_PASS
  SEARCH_ATTENDEE
  VIEW_DASHBOARD
  VIEW_ACTIVITY
  SEND_NOTIFICATION
  SEND_ANNOUNCEMENT
  MANAGE_STAFF
  MANAGE_VENDORS
  VIEW_REPORTS
  EDIT_EVENT
}

enum EventCategory {
  BUSINESS
  TECHNOLOGY
  STARTUP
  MUSIC
  CONCERT
  COMEDY
  CHURCH
  CONFERENCE
  SPORTS
  FESTIVAL
  EXHIBITION
  EDUCATION
  FOOD
  FASHION
  HEALTH
  FAMILY
  CHARITY
  GOVERNMENT
  OTHER
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  phone String?

  role UserRole

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * |--------------------------------------------------------------------------
   * | Organization
   * |--------------------------------------------------------------------------
   */

  organization Organization?

  /**
   * |--------------------------------------------------------------------------
   * | Attendee
   * |--------------------------------------------------------------------------
   */

  attendeeProfile AttendeeProfile?

  attendees Attendee[]

  registrations Registration[]

  purchases TicketPurchase[]

  ticketCheckIns TicketCheckIn[]

  /**
   * |--------------------------------------------------------------------------
   * | Notifications
   * |--------------------------------------------------------------------------
   */

  deviceTokens DeviceToken[]

  notifications Notification[]
}

model Organization {
  id String @id @default(cuid())

  name String

  slug String @unique

  logo String?

  website String?

  ownerId String @unique

  owner User @relation(fields: [ownerId], references: [id])

  events Event[]

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())

  /**
   * |--------------------------------------------------------------------------
   * | Basic Information
   * |--------------------------------------------------------------------------
   */

  title String

  description String

  venue String

  coverImage String?

  featuredImage String?

  category EventCategory?

  capacity Int

  currency String @default("USD")

  startDate DateTime

  endDate DateTime

  status EventStatus @default(DRAFT)

  isPublic Boolean @default(true)

  /**
   * |--------------------------------------------------------------------------
   * | Discovery
   * |--------------------------------------------------------------------------
   */

  views Int @default(0)

  wishlistCount Int @default(0)

  shareCount Int @default(0)

  homepageScore Float @default(0)

  featuredUntil DateTime?

  /**
   * |--------------------------------------------------------------------------
   * | Vendor Marketplace
   * |--------------------------------------------------------------------------
   */

  vendorApplicationsOpen Boolean @default(false)

  vendorApplicationDeadline DateTime?

  maxVendorSlots Int?

  /**
   * |--------------------------------------------------------------------------
   * | Ownership
   * |--------------------------------------------------------------------------
   */

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  /**
   * |--------------------------------------------------------------------------
   * | Event Data
   * |--------------------------------------------------------------------------
   */

  tickets TicketType[]

  attendees Attendee[]

  purchases TicketPurchase[]

  registrations Registration[]

  staff EventStaff[]

  activities EventActivity[]

  announcements Announcement[]

  sessions Session[]

  vendorApplications VendorApplication[]

  /**
   * |--------------------------------------------------------------------------
   * | Metadata
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Registration {
  id String @id @default(cuid())

  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model AttendeeProfile {
  id String @id @default(cuid())

  userId String @unique

  /**
   * |--------------------------------------------------------------------------
   * | Professional Information
   * |--------------------------------------------------------------------------
   */

  profession String?

  industry String?

  company String?

  jobTitle String?

  /**
   * |--------------------------------------------------------------------------
   * | Networking
   * |--------------------------------------------------------------------------
   */

  goals Json?

  skills Json?

  linkedin String?

  avatar String?

  bio String?

  /**
   * |--------------------------------------------------------------------------
   * | Metadata
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * |--------------------------------------------------------------------------
   * | Relations
   * |--------------------------------------------------------------------------
   */

  user User @relation(fields: [userId], references: [id])
}

model TicketType {
  id String @id @default(cuid())

  /**
   * |--------------------------------------------------------------------------
   * | Parent
   * |--------------------------------------------------------------------------
   */

  eventId String

  event Event @relation(fields: [eventId], references: [id])

  /**
   * |--------------------------------------------------------------------------
   * | Ticket Information
   * |--------------------------------------------------------------------------
   */

  name String

  description String?

  color String?

  benefits Json?

  /**
   * |--------------------------------------------------------------------------
   * | Pricing
   * |--------------------------------------------------------------------------
   */

  price Float

  quantity Int

  sold Int @default(0)

  isActive Boolean @default(true)

  /**
   * |--------------------------------------------------------------------------
   * | Relations
   * |--------------------------------------------------------------------------
   */

  attendees Attendee[]

  purchases TicketPurchase[]

  /**
   * |--------------------------------------------------------------------------
   * | Metadata
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())

  updatedAt     DateTime        @updatedAt
  EventActivity EventActivity[]
}

model VendorApplication {
  id String @id @default(cuid())

  eventId String

  // Future-proof: nullable for now until Vendor accounts exist
  vendorId String?

  businessName String

  category String

  contactName String

  email String

  phone String

  description String

  boothSize String?

  message String?

  status VendorStatus @default(PENDING)

  reviewedAt DateTime?

  approvedAt DateTime?

  rejectedAt DateTime?

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([status])
  @@index([email])
  @@index([vendorId])
}

model TicketPurchase {
  id String @id @default(cuid())

  /**
   * |--------------------------------------------------------------------------
   * | Ownership
   * |--------------------------------------------------------------------------
   */

  userId String

  eventId String

  ticketTypeId String

  /**
   * |--------------------------------------------------------------------------
   * | Purchase
   * |--------------------------------------------------------------------------
   */

  quantity Int

  amount Float

  currency String @default("USD")

  paymentMethod String?

  stripeSessionId String?

  status PurchaseStatus @default(PENDING)

  /**
   * |--------------------------------------------------------------------------
   * | Check-In
   * |--------------------------------------------------------------------------
   */

  checkedIn Boolean @default(false)

  checkedInAt DateTime?

  /**
   * |--------------------------------------------------------------------------
   * | Relations
   * |--------------------------------------------------------------------------
   */

  user User @relation(fields: [userId], references: [id])

  event Event @relation(fields: [eventId], references: [id])

  ticket TicketType @relation(fields: [ticketTypeId], references: [id])

  attendees Attendee[]

  checkIn TicketCheckIn?

  activities EventActivity[]

  EventPass EventPass?

  /**
   * |--------------------------------------------------------------------------
   * | Metadata
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())
}

model EventPass {
  id              String    @id @default(cuid())
  passNumber      String    @unique
  purchaseId      String    @unique
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastGeneratedAt DateTime?
  expiresAt       DateTime?

  purchase TicketPurchase @relation(fields: [purchaseId], references: [id])
}

model TicketCheckIn {
  id String @id @default(cuid())

  purchaseId String @unique

  checkedInBy String

  station String?

  deviceId String?

  checkedInAt DateTime @default(now())

  purchase TicketPurchase @relation(fields: [purchaseId], references: [id])

  staff  EventStaff @relation(fields: [checkedInBy], references: [id])
  User   User?      @relation(fields: [userId], references: [id])
  userId String?

  @@index([checkedInBy])
  @@index([checkedInAt])
}

model EventStaff {
  id String @id @default(cuid())

  eventId String

  name String

  phone String?

  email String?

  role EventStaffRole

  station String?

  checkIns TicketCheckIn[]

  accessCode String @unique

  sessions OperationSession[]

  permissions StaffPermission[]

  isActive Boolean @default(true)

  isRevoked Boolean @default(false)

  invitedBy String?

  acceptedAt DateTime?

  expiresAt DateTime?

  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  event         Event           @relation(fields: [eventId], references: [id])
  Announcement  Announcement[]
  EventActivity EventActivity[]

  @@index([eventId])
  @@index([accessCode])
  @@index([eventId, isActive])
}

model Notification {
  id String @id @default(cuid())

  userId String

  title String

  body String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DeviceToken {
  id String @id @default(cuid())

  userId String

  token String @unique

  platform String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Announcement {
  id String @id @default(cuid())

  eventId String

  authorId String

  title String

  message String

  type AnnouncementType @default(INFO)

  priority AnnouncementPriority @default(NORMAL)

  audience AnnouncementAudience @default(ALL)

  isPinned Boolean @default(false)

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id])

  author EventStaff @relation(fields: [authorId], references: [id])
}

model Session {
  id String @id @default(cuid())

  eventId String

  title String

  speaker String?

  venue String?

  startTime DateTime

  endTime DateTime

  event Event @relation(fields: [eventId], references: [id])
}

model Connection {
  id String @id @default(cuid())

  requesterId String

  receiverId String

  accepted Boolean @default(false)

  createdAt DateTime @default(now())
}

model EventActivity {
  id String @id @default(cuid())

  /*
  |--------------------------------------------------------------------------
  | Parent
  |--------------------------------------------------------------------------
  */

  eventId String

  event Event @relation(fields: [eventId], references: [id])

  /*
  |--------------------------------------------------------------------------
  | Relationships
  |--------------------------------------------------------------------------
  */

  actorId String?

  actor EventStaff? @relation(fields: [actorId], references: [id])

  attendeeId String?

  attendee Attendee? @relation(fields: [attendeeId], references: [id])

  purchaseId String?

  purchase TicketPurchase? @relation(fields: [purchaseId], references: [id])

  ticketTypeId String?

  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  /*
  |--------------------------------------------------------------------------
  | Activity
  |--------------------------------------------------------------------------
  */

  type String

  title String

  description String

  station String?

  payload Json?

  /*
  |--------------------------------------------------------------------------
  | Metadata
  |--------------------------------------------------------------------------
  */

  createdAt DateTime @default(now())

  @@index([eventId])

  @@index([eventId, createdAt])

  @@index([actorId])

  @@index([attendeeId])

  @@index([purchaseId])

  @@index([ticketTypeId])

  @@index([type])
}

model OperationSession {
  id String @id @default(cuid())

  staffId String

  token String @unique

  deviceId String?

  deviceName String?

  ipAddress String?

  startedAt DateTime @default(now())

  lastSeenAt DateTime @updatedAt

  endedAt DateTime?

  isActive Boolean @default(true)

  staff EventStaff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model Attendee {
  id String @id @default(cuid())

  /**
   * |--------------------------------------------------------------------------
   * | Relationships
   * |--------------------------------------------------------------------------
   */

  eventId String

  userId String

  purchaseId String?

  ticketTypeId String?

  /**
   * |--------------------------------------------------------------------------
   * | Attendance
   * |--------------------------------------------------------------------------
   */

  status AttendeeStatus @default(REGISTERED)

  checkedIn Boolean @default(false)

  checkedInAt DateTime?

  checkedOutAt DateTime?

  checkInStation String?

  /**
   * |--------------------------------------------------------------------------
   * | Networking
   * |--------------------------------------------------------------------------
   */

  isNetworkingEnabled Boolean @default(true)

  /**
   * |--------------------------------------------------------------------------
   * | Metadata
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * |--------------------------------------------------------------------------
   * | Relations
   * |--------------------------------------------------------------------------
   */

  event Event @relation(fields: [eventId], references: [id])

  user User @relation(fields: [userId], references: [id])

  purchase TicketPurchase? @relation(fields: [purchaseId], references: [id])

  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  activities EventActivity[]

  /**
   * |--------------------------------------------------------------------------
   * | Constraints
   * |--------------------------------------------------------------------------
   */

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([purchaseId])
  @@index([ticketTypeId])
  @@index([status])
  @@index([checkedIn])
}
